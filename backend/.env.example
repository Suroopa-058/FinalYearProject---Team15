# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# The TanStack Start frontend runs on 3000 by default (vite dev).
CORS_ORIGIN=http://localhost:3000

# Required: set a unique, cryptographically secure 32-character-or-longer secret.
AUTH_TOKEN_SECRET=replace-with-a-unique-32-character-or-longer-secret

# ── Data source ───────────────────────────────────────────────────────────
# For now data is stored as JSON files on disk (see src/data/db).
# Swap DATA_DRIVER to "postgres" / "mongo" / etc. once a real DB is wired up.
DATA_DRIVER=json-file
DATA_DIR=./src/data/db

# ── ML service (ScholarMatch FastAPI, existing trained artifacts) ─────────
# Base URL of the existing FastAPI service (fastapi_integration/app.py).
# Node proxies to this — it does not load or run the model itself.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=15000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=dev
